{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "rooms": {
      "$room": {
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".validate": "newData.hasChildren(['slide','round','phase','deadline','completed','final','updatedAt'])",
          "slide": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 39 && newData.val() % 1 == 0"
          },
          "round": {
            ".validate": "newData.val() == 'none' || newData.val() == 'c1' || newData.val() == 'c2' || newData.val() == 'c3' || newData.val() == 'c4'"
          },
          "phase": {
            ".validate": "newData.val() == 'idle' || newData.val() == 'open' || newData.val() == 'closed'"
          },
          "deadline": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 300000"
          },
          "completed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 == 0"
          },
          "final": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && $room.matches(/^[A-Z0-9]{4,8}$/) && root.child('rooms').child($room).child('state').exists() && root.child('rooms').child($room).child('state').child('final').val() == false && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['name','joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
          "c1": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('players').child($uid).exists() && root.child('rooms').child($room).child('state').child('round').val() == 'c1' && root.child('rooms').child($room).child('state').child('phase').val() == 'open' && root.child('rooms').child($room).child('state').child('final').val() == false && root.child('rooms').child($room).child('state').child('deadline').val() > now && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['answer','at'])",
              "answer": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 == 0"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "c2": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('players').child($uid).exists() && root.child('rooms').child($room).child('state').child('round').val() == 'c2' && root.child('rooms').child($room).child('state').child('phase').val() == 'open' && root.child('rooms').child($room).child('state').child('final').val() == false && root.child('rooms').child($room).child('state').child('deadline').val() > now && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['answer','at'])",
              "answer": {
                ".validate": "newData.hasChildren(['0','1','2'])",
                "0": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2 && newData.val() % 1 == 0"
                },
                "1": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2 && newData.val() % 1 == 0"
                },
                "2": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2 && newData.val() % 1 == 0"
                },
                "$other": {
                  ".validate": false
                }
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "c3": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('players').child($uid).exists() && root.child('rooms').child($room).child('state').child('round').val() == 'c3' && root.child('rooms').child($room).child('state').child('phase').val() == 'open' && root.child('rooms').child($room).child('state').child('final').val() == false && root.child('rooms').child($room).child('state').child('deadline').val() > now && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['answer','at'])",
              "answer": {
                ".validate": "newData.hasChildren(['0','1','2','3'])",
                "0": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1 && newData.val() % 1 == 0"
                },
                "1": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1 && newData.val() % 1 == 0"
                },
                "2": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1 && newData.val() % 1 == 0"
                },
                "3": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1 && newData.val() % 1 == 0"
                },
                "$other": {
                  ".validate": false
                }
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "c4": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('players').child($uid).exists() && root.child('rooms').child($room).child('state').child('round').val() == 'c4' && root.child('rooms').child($room).child('state').child('phase').val() == 'open' && root.child('rooms').child($room).child('state').child('final').val() == false && root.child('rooms').child($room).child('state').child('deadline').val() > now && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['answer','at'])",
              "answer": {
                ".validate": "newData.hasChildren(['0','1','2','3','4','5'])",
                "0": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "1": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "2": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "3": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "4": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "5": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0"
                },
                "$other": {
                  ".validate": false
                }
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "results": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
        }
      }
    }
  }
}
